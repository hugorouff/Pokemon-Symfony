{% set nav = {'accueil': 'Accueil', 'cartes': 'Rechercher une carte', 'boosters': 'Ouvrir un booster', 'collection': 'Ma collection', 'pokedex': 'Pokédex', 'albums': 'Albums', 'decks': 'Decks', 'emulateur': 'Mes ROMs', 'compte': 'Mon compte', 'objectifs': 'Objectifs', 'classeur': 'Classeur'} %}
{% set navGroups = {'Cartes': ['cartes', 'boosters', 'pokedex'], 'Collection': ['collection', 'albums', 'decks', 'objectifs', 'classeur']} %}
{% set packs = {
    'feu': ['Feu', 'feu'], 'eau': ['Eau', 'eau'], 'plante': ['Plante', 'plante'],
    'electrique': ['Électrique', 'elec'], 'psy': ['Psy', 'psy'], 'combat': ['Combat', 'combat'],
    'tenebres': ['Ténèbres', 'dark'], 'incolore': ['Incolore', 'incolore'], 'random': ['Aléatoire', 'random']
} %}
<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101118">
    <title>{{ nav[section] }} · Pokémon TCG App</title>
    <link rel="manifest" href="/manifest.webmanifest?v=dashboard-icons">
    <link rel="icon" href="/assets/pwa/app-192.png" sizes="192x192">
    <link rel="apple-touch-icon" href="/assets/pwa/app-180.png">
    <script type="module" src="/assets/shell.js"></script>
    <link rel="stylesheet" href="/assets/app.css?v=home-guide">
    {% if section == 'pokedex' %}
        <link rel="stylesheet" href="/assets/pokedex.css?v=dex-fiche">
        <script type="module" src="/assets/app.js?v=dex-fiche"></script>
    {% elseif section == 'emulateur' %}
        <link rel="stylesheet" href="/assets/nds-player.css?v=rom-guide">
        <script type="module" src="/assets/nds-player.js?v=nds-threads"></script>
    {% elseif section in ['objectifs', 'classeur'] %}
        <script type="module" src="/assets/feature-pages.js"></script>
    {% elseif section == 'compte' or (section == 'accueil' and not signedIn) %}
        <script type="module" src="/assets/account.js?v=dashboard"></script>
    {% elseif section != 'accueil' %}
        <script type="module" src="/assets/app.js?v=booster-album"></script>
    {% endif %}
</head>
<body data-section="{{ section }}">
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="site-head">
    <div class="shell head-inner">
        {% if signedIn %}
            <a class="brand" href="{{ path('home') }}"{% if section == 'accueil' %} aria-current="page"{% endif %}><img src="/assets/pwa/app-192.png" width="34" height="34" alt=""> <span>Pokémon <b>TCG</b></span></a>
            <nav aria-label="Navigation principale">
                <ul class="menu">
                    {% for group, keys in navGroups %}
                        <li>
                            <details class="nav-group">
                                <summary{% if section in keys %} class="current-group"{% endif %}>{{ group }}</summary>
                                <ul class="nav-group-links">
                                    {% for key in keys %}
                                        <li><a href="{{ path('section', {section:key}) }}"{% if key == section %} aria-current="page"{% endif %}>{{ nav[key] }}</a></li>
                                    {% endfor %}
                                </ul>
                            </details>
                        </li>
                    {% endfor %}
                    <li><a href="{{ path('section', {section:'emulateur'}) }}"{% if section == 'emulateur' %} aria-current="page"{% endif %}>Jouer</a></li>
                    <li><a href="{{ path('section', {section:'compte'}) }}"{% if section == 'compte' %} aria-current="page"{% endif %}>Mon compte</a></li>
                </ul>
            </nav>
        {% else %}
            <span class="brand"><img src="/assets/pwa/app-192.png" width="34" height="34" alt=""> <span>Pokémon <b>TCG</b></span></span>
        {% endif %}
        <button id="install-app" class="install-app" type="button" hidden>Installer l’appli</button>
    </div>
</header>
{% if signedIn and section != 'accueil' %}
    <nav id="breadcrumb" aria-label="Fil d’Ariane"><div class="shell"><a href="{{ path('home') }}">Accueil</a><span aria-hidden="true"> &gt; </span><span aria-current="page">{{ nav[section] }}</span></div></nav>
{% endif %}
<main class="shell" id="contenu">
{% if section == 'accueil' %}
    {% include 'home.html.twig' %}
{% elseif section == 'cartes' %}
    <section id="header-search" class="tcg-heading">
        <h1>Pokémon TCG Explorer</h1>
        <form class="filters" id="filters">
            <label class="wide">Rechercher<input name="q" type="search" maxlength="100" placeholder="Rechercher une carte (ex. Pikachu)" autocomplete="off"></label>
            <label>Langue<select name="lang"><option value="fr">Français</option><option value="en">Anglais</option></select></label>
            <label class="wide">Série<select name="set"><option value="">Toutes les séries</option></select></label>
            <label>Type<select name="type"><option value="">Tous les types</option>{% for id, pack in packs %}{% if id != 'random' %}<option value="{{ id }}">{{ pack[0] }}</option>{% endif %}{% endfor %}</select></label>
            <label>Tri<select name="sort"><option value="catalogue">Catalogue</option><option value="az">Nom A–Z</option><option value="za">Nom Z–A</option></select></label>
            <button class="primary">Rechercher</button>
        </form>
    </section>
    <section class="cards-section">
        <h2>Cartes Pokémon</h2><p id="status" class="status" role="status"></p>
        <div id="results" class="card-grid"></div>
        <nav id="pager" class="pager" aria-label="Pages des cartes"></nav>
    </section>
{% elseif section == 'boosters' %}
    <section id="header-search" class="tcg-heading">
        <h1>Pokémon TCG Booster</h1>
        <form class="filters" id="filters">
            <label>Langue<select name="lang"><option value="fr">Français</option><option value="en">Anglais</option></select></label>
            <label class="wide">Série<select name="set"><option value="">Toutes les séries</option></select></label>
        </form>
    </section>
    <div class="booster-container" aria-label="Choisir un booster">
        {% for id, pack in packs %}
            <button class="booster" type="button" data-booster="{{ id }}">
                <img src="/assets/boosters/{{ pack[1] }}.jpg" alt="" width="1024" height="1024" loading="{{ loop.index > 3 ? 'lazy' : 'eager' }}">
                <strong class="booster-name">Booster {{ pack[0] }}</strong>
                <span class="remaining" data-remaining>Vérification des ouvertures…</span>
            </button>
        {% endfor %}
    </div>
    <p id="status" class="status" role="status"></p>
    <section id="booster-album" class="panel booster-album" aria-labelledby="booster-album-title" hidden>
        <header>
            <div><h2 id="booster-album-title" tabindex="-1">Album du booster</h2><p id="booster-reveal-count" role="status"></p></div>
            <div class="actions">
                <button type="button" class="primary" id="booster-reveal-next">Révéler la suivante</button>
                <button type="button" class="secondary" id="booster-reveal-all">Tout révéler</button>
                <a class="secondary" href="/collection">Ma collection</a>
            </div>
        </header>
        <div id="results" class="pack-album-grid"></div>
    </section>
{% elseif section == 'collection' %}
    <header class="page-title dashboard-title">
        <div><h1>Ma collection</h1><p>Retrouve tes cartes, tes favoris et tes doubles.</p></div>
        <a class="primary" href="{{ path('section', {section: 'boosters'}) }}">Ouvrir un booster <span class="jump-arrow" aria-hidden="true"></span></a>
    </header>
    <dl class="collection-metrics" id="collection-metrics" hidden>
        <div><dt>Cartes différentes</dt><dd id="collection-unique"></dd></div>
        <div><dt>Exemplaires</dt><dd id="collection-total"></dd></div>
        <div><dt>Favoris</dt><dd id="collection-favorites"></dd></div>
        <div><dt>Cartes en double</dt><dd id="collection-duplicates"></dd></div>
    </dl>
    <p id="collection-guest" hidden><a href="/compte">Connecte-toi ou crée ton compte</a> pour retrouver tes cartes sur tes autres appareils.</p>
    <form class="panel filters collection-filters" id="filters" aria-label="Filtrer ma collection">
        <label>Rechercher<input name="q" type="search" placeholder="Nom ou identifiant"></label>
        <label>Afficher<select name="view"><option value="all">Toutes les cartes</option><option value="favorites">Favoris</option><option value="duplicates">Doubles</option></select></label>
        <label>Type<select name="type"><option value="">Tous les types</option></select></label>
        <label>Rareté<select name="rarity"><option value="">Toutes les raretés</option></select></label>
        <label>Tri<select name="sort"><option value="az">Nom A–Z</option><option value="za">Nom Z–A</option><option value="quantity">Quantité</option><option value="rarity">Rareté</option><option value="type">Type</option></select></label>
        <button class="primary" type="submit">Filtrer</button>
    </form>
    <section class="collection-results" aria-labelledby="collection-list-title">
        <div class="collection-toolbar">
            <h2 id="collection-list-title">Mes cartes</h2>
            <details class="transfer panel">
                <summary>Importer ou exporter</summary>
                <div class="actions">
                    <button class="secondary" type="button" id="export">Exporter en JSON</button>
                    <label class="secondary upload">Importer un JSON<input id="import" type="file" accept="application/json,.json"></label>
                    <button id="import-local-collection" type="button" class="secondary" hidden>Importer mes cartes de ce navigateur</button>
                </div>
            </details>
        </div>
        <p id="status" class="status" role="status">Chargement de ta collection…</p>
        <div id="results" class="card-grid"></div>
    </section>
{% elseif section == 'albums' %}
    <header class="page-title"><p class="eyebrow">Mes cartes</p><h1>Albums par série</h1><p>Comparez votre collection au catalogue et retrouvez les cartes qui vous manquent.</p></header>
    <form id="album-filters" class="panel filters">
        <label>Langue<select name="lang"><option value="fr">Français</option><option value="en">Anglais</option></select></label>
        <label class="wide">Série<input name="q" type="search" maxlength="100" placeholder="Nom d’une série" autocomplete="off"></label>
        <label>Progression<select name="view"><option value="all">Toutes les séries</option><option value="started">Séries commencées</option><option value="complete">Séries terminées</option><option value="near">Proches d’être complétées</option></select></label>
    </form>
    <p id="status" class="status" role="status"></p>
    <section id="album-detail" class="panel album-detail" hidden>
        <div class="album-heading"><h2 id="album-name"></h2><button class="secondary" id="close-album" type="button">Fermer la série</button></div>
        <div id="album-views" class="actions" aria-label="Cartes de la série"></div>
        <p id="album-summary" class="status" role="status"></p>
        <div id="results" class="card-grid"></div>
        <nav id="album-pages" class="pager" aria-label="Pages de la série"></nav>
    </section>
    <div id="album-list" class="album-grid"></div>
{% elseif section == 'decks' %}
    <header class="page-title"><p class="eyebrow">Mes cartes</p><h1>Mes decks</h1><p>Composez plusieurs decks de 60 cartes à partir de votre collection et exportez leurs listes.</p></header>
    <form class="panel filters" id="new-deck">
        <label class="wide">Nom du nouveau deck<input name="name" type="text" maxlength="60" placeholder="Mon premier deck" required></label>
        <button class="primary">Créer un deck</button>
    </form>
    <p id="status" class="status" role="status"></p>
    <button id="deck-import-local" type="button" class="secondary" hidden>Importer mes decks de ce navigateur</button>
    <section id="deck-layout" class="workbench" hidden>
        <div class="panel deck-panel">
            <h2>Composition</h2>
            <label>Deck actif<select id="deck-select"></select></label>
            <form id="rename-deck" class="actions"><label>Nouveau nom<input name="name" type="text" maxlength="60" required></label><button class="secondary">Renommer</button></form>
            <progress id="deck-progress" value="0" max="60" aria-label="Cartes dans le deck"></progress>
            <p id="deck-count" role="status"></p>
            <ul id="deck-entries" class="workbench-list"></ul>
            <div class="actions"><button class="secondary" id="deck-export" type="button">Exporter la liste</button><button class="secondary" id="deck-delete" type="button">Supprimer le deck</button></div>
        </div>
        <div class="panel deck-panel">
            <h2>Cartes de la collection</h2>
            <label>Rechercher<input id="deck-search" type="search" placeholder="Nom ou numéro de carte"></label>
            <label class="checkbox"><input id="deck-favorites" type="checkbox"> Favoris uniquement</label>
            <ul id="deck-library" class="workbench-list"></ul>
            <nav id="deck-pages" class="pager" aria-label="Pages de la collection"></nav>
        </div>
    </section>
    <form id="deck-comparison" class="panel filters" hidden>
        <h2>Deck contre deck</h2>
        <label>Premier deck<select id="compare-first"></select></label>
        <label>Carte clé du premier deck<select id="compare-key-first"></select></label>
        <label>Second deck<select id="compare-second"></select></label>
        <label>Carte clé du second deck<select id="compare-key-second"></select></label>
        <button class="primary" type="submit">Simuler deux mains de 7 cartes</button>
        <div class="account-forms" id="compare-results" aria-live="polite"></div>
    </form>
{% elseif section == 'pokedex' %}
    {% include 'pokedex.html.twig' %}
{% elseif section in ['objectifs', 'classeur'] %}
    {% include 'player-features.html.twig' %}
{% elseif section == 'compte' %}
    {% include 'account.html.twig' %}
{% elseif section == 'emulateur' %}
    {% include 'nds-player.html.twig' %}
{% endif %}
</main>
{% if signedIn %}<footer class="site-foot"><span>Pokémon TCG App · Données <a href="https://tcgdex.dev/">TCGdex</a> et <a href="https://pokeapi.co/">PokéAPI</a></span></footer>{% endif %}
<dialog id="detail"><div class="dialog-top"><button id="close-detail" class="secondary" type="button">Fermer <span aria-hidden="true">×</span></button></div><div id="detail-content"></div></dialog>
<dialog id="install-help" aria-labelledby="install-title">
    <div class="dialog-top"><form method="dialog"><button class="secondary">Fermer</button></form></div>
    <h2 id="install-title">Installer l’application</h2>
    <p id="install-instructions"></p>
</dialog>
</body>
</html>
