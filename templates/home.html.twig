<section class="home-hero" aria-labelledby="home-title">
    <div class="home-copy">
        <h1 id="home-title">Pokémon<br><em>TCG App</em></h1>
        <p>Collectionne tes cartes, ouvre des boosters et retrouve tes parties Nintendo DS.</p>
        <div class="actions">
            {% if signedIn %}
                <a class="primary" href="{{ path('section', {section: 'collection'}) }}">Ma collection</a>
                <a class="secondary" href="{{ path('section', {section: 'emulateur'}) }}">Jouer sur DS <span class="jump-arrow" aria-hidden="true"></span></a>
            {% else %}
                <a class="primary" href="#account-login">Se connecter</a>
                <a class="secondary" href="#account-register">Créer un compte</a>
            {% endif %}
        </div>
    </div>
    <ul class="home-lineup" aria-label="Pokémon favoris">
        {% set favorites = {
            'lucario': ['Lucario', 448, 'Combat / Acier'],
            'rayquaza': ['Rayquaza', 384, 'Dragon / Vol'],
            'reshiram': ['Reshiram', 643, 'Dragon / Feu']
        } %}
        {% for key, pokemon in favorites %}
            <li class="lineup-{{ key }}">
                <span class="lineup-number" aria-hidden="true">#{{ pokemon[1] }}</span>
                <img src="/assets/favorites/{{ key }}.webp" alt="" fetchpriority="{{ key == 'rayquaza' ? 'high' : 'auto' }}">
                <div class="lineup-caption"><strong>{{ pokemon[0] }}</strong><span>{{ pokemon[2] }}</span></div>
            </li>
        {% endfor %}
    </ul>
</section>
{% if signedIn %}
    <nav class="home-overview" aria-label="Raccourcis de l’accueil">
        {% set shortcuts = {
            'Cartes et collection': [
                ['cartes', 'Catalogue de cartes', 'Recherche des cartes en français ou en anglais, par nom, série ou type.'],
                ['boosters', 'Boosters', 'Ouvre un booster, révèle ses cinq cartes dans l’album interactif et retrouve-les dans ta collection.'],
                ['collection', 'Ma collection', 'Gère tes exemplaires, favoris et doubles. Importe ou exporte ta collection en JSON.'],
                ['albums', 'Albums', 'Suis ta progression par série, repère les cartes manquantes et ajoute-les à tes recherches.'],
                ['decks', 'Decks', 'Compose et synchronise tes decks de 60 cartes, exporte-les et compare leurs mains de départ.'],
                ['objectifs', 'Objectifs', 'Retrouve les cartes que tu recherches et suis tes défis de collection.'],
                ['classeur', 'Classeur', 'Expose jusqu’à neuf cartes et partage ton classeur par lien.']
            ],
            'Pokédex et capacités': [
                ['pokedex', 'Pokédex 3D', 'Observe les modèles disponibles à 360°, compare les formes Méga et Gigamax, écoute leurs cris et enregistre tes favoris.'],
                ['pokedex', 'Laboratoire 3D', 'Explore les 971 entrées de capacités en arène, dont les capacités Z et Gigamax, et rejoue les scènes de transformation.', {vue: 'laboratoire'}]
            ],
            'Jeux Nintendo DS et compte': [
                ['emulateur', 'Mes ROMs', 'Joue dans le navigateur, reprends ta partie, gère tes sauvegardes, synchronise les commandes et tiens ton carnet d’aventure.'],
                ['compte', 'Mon compte', 'Gère ta connexion et retrouve tes données personnelles. Pour accéder au site comme à une application, utilise « Installer l’appli » dans l’en-tête.']
            ]
        } %}
        {% for group, links in shortcuts %}
            <section aria-labelledby="home-group-{{ loop.index }}">
                <h2 id="home-group-{{ loop.index }}">{{ group }}</h2>
                <div class="home-shortcuts">
                    {% for shortcut in links %}
                        <a href="{{ path('section', {section: shortcut[0]}|merge(shortcut[3]|default({}))) }}">
                            <strong>{{ shortcut[1] }}</strong><span>{{ shortcut[2] }}</span><span class="shortcut-arrow" aria-hidden="true"></span>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </nav>
{% else %}
    {% include 'account.html.twig' %}
{% endif %}
<p class="art-credit">Illustrations via <a href="https://github.com/PokeAPI/sprites">PokéAPI</a></p>
