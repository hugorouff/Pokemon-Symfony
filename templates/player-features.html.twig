<header class="page-title">
    <h1>{{ nav[section] }}</h1>
    {% if section == 'objectifs' %}<p>Retrouve les cartes recherchées et suis tes défis de collection.</p>{% endif %}
</header>
<p id="feature-status" class="status" role="status"></p>
<p id="feature-login" hidden><a href="/compte">Connecte-toi ou crée ton compte</a> pour utiliser cette rubrique.</p>

{% if section == 'objectifs' %}
<div id="feature-content" class="account-forms" hidden>
    <section class="panel account-panel">
        <h2>Cartes recherchées</h2>
        <a href="/albums">Marquer des cartes dans les albums</a>
        <ul id="wished-cards" class="workbench-list"></ul>
    </section>
    <section class="panel account-panel">
        <h2>Défis de collection</h2>
        <div id="water-challenge"></div>
        <label for="challenge-album">Série à compléter à 50 %</label>
        <select id="challenge-album"></select>
        <div id="album-challenge"></div>
    </section>
</div>
{% else %}
<section id="feature-content" class="panel account-panel" hidden>
    <label for="shelf-picker">Choisis jusqu’à neuf cartes de ta collection</label>
    <select id="shelf-picker" multiple size="9"></select>
    <label class="checkbox"><input id="shelf-publish" type="checkbox"> Rendre le classeur accessible avec son lien</label>
    <button id="save-shelf" class="primary" type="button">Enregistrer le classeur</button>
    <a id="shelf-link" hidden></a>
</section>
<div id="display-shelf" class="shelf-grid card-grid" aria-label="Cartes du classeur"></div>
{% endif %}
