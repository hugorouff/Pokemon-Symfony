{
  "name": "atelier/pokemon-symfony",
  "description": "Atlas de cartes, Pokédex et aventure dans le navigateur",
  "type": "project",
  "require": {
    "php": ">=8.4.1",
    "ext-zlib": "*",
    "aws/aws-sdk-php": "^3.0",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "config": {
    "platform": {"php": "8.4.1"},
    "sort-packages": true
  }
}
